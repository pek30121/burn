# Copy to .env (never commit .env). Server-side only: never ship these to a browser.

# Solana cluster the engine indexes: devnet | mainnet-beta
SOLANA_CLUSTER=devnet

# RPC endpoint. Keep the API key in this variable only; the public API never echoes it.
# Example (Helius): https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com

# PostgreSQL connection string (used from step 2 onward)
DATABASE_URL=postgres://engine:engine@localhost:5432/engine

# Path to the JSON file listing the token projects this instance serves
PROJECTS_CONFIG=./config/projects.example.json

# HTTP API
PORT=8787
