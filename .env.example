# Copy to .env (never commit .env). Server-side only: never ship these to a browser.

# --- Engine (npm start). Server-side only: never ship these to a browser. ---
# Cluster the RPC serves. Every project in PROJECTS_CONFIG must be on this cluster.
SOLANA_CLUSTER=mainnet-beta
# Any Solana JSON-RPC endpoint (Helius is optional). The URL, API key and host are never logged.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Projects file (see config/projects.example.json)
PROJECTS_CONFIG=./config/projects.example.json

# --- Polling and cost control (all optional; defaults are frugal) ---
POLL_INTERVAL_MS=10000          # wait between syncs of a caught-up project (min 1000)
ERROR_BACKOFF_BASE_MS=2000      # first retry delay after a failure, doubled each time...
ERROR_BACKOFF_MAX_MS=60000      # ...up to this
RPC_MAX_CONCURRENCY=4           # requests in flight, all projects together
RPC_MIN_INTERVAL_MS=100         # minimum delay between two request starts (100 = max 10 requests/s)
RPC_MAX_RETRIES=4
RPC_TIMEOUT_MS=20000
INDEXER_PAGE_SIZE=1000
BACKFILL_PAGES_PER_SYNC=1
TRACK_CONFIRMED=false           # true = extra calls to show not-yet-finalized burns
# Local credit ESTIMATE per RPC method (not the provider's billing). Default: 1 per request.
# RPC_CREDIT_COSTS={"getTransaction":1,"getSignaturesForAddress":1,"getTokenSupply":1}
SHUTDOWN_TIMEOUT_MS=20000
STATUS_LOG_INTERVAL_MS=300000   # 0 disables the periodic engine_status log
MIGRATE_ON_START=true           # false = refuse to start if migrations are pending
LOG_LEVEL=info                  # debug | info | warn | error

# PostgreSQL connection string (never logged; Replit's built-in PostgreSQL provides it)
DATABASE_URL=postgres://engine:engine@localhost:5432/engine
# Pool / timeouts (optional)
PG_POOL_MAX=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=15000

# Tests only: a DEDICATED database whose name contains "test" (each test uses its own schema).
# Without it the PostgreSQL tests are skipped and reported as skipped.
# TEST_DATABASE_URL=postgres://engine_test:engine_test_pw@127.0.0.1:5432/engine_test

# Path to the JSON file listing the token projects this instance serves
PROJECTS_CONFIG=./config/projects.example.json

# HTTP API
PORT=8787
