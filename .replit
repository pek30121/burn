# Replit (Devnet only): ONE container runs the test page + /rpc proxy (public port) AND the burn engine (PostgreSQL, indexers,
# read-only API on 127.0.0.1, reached through the page's own origin). See deploy/README.md.
modules = ["nodejs-22"]
run = "npm install --no-audit --no-fund --include=dev && npm run build:replit && npm run replit:start"

[env]
SOLANA_CLUSTER = "devnet"
PROJECTS_CONFIG = "deploy/projects.devnet.json"
WEB_CONFIG_FILE = "deploy/wallet-test-config.json"
RPC_MONTHLY_CREDITS = "10000000"

[nix]
channel = "stable-24_05"

[deployment]
# Kept on Autoscale (no cost change by itself). The engine only indexes while an instance is awake and catches up on wake-up;
# for an engine that never sleeps, switch the deployment type to Reserved VM in the Publish panel (paid: see deploy/README.md).
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --no-audit --no-fund --include=dev && npm run build:replit"]
run = ["sh", "-c", "npm run replit:start"]

[[ports]]
localPort = 8080
externalPort = 80
