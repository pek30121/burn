# Replit, MAINNET (FLAPY): the burn engine alone serves the read-only public API on the public port (supervisor mainnetSpecs).
# The network is ALSO pinned in the run commands below, so it does not depend on how Replit passes [env] to a deployment.
# ROLLBACK TO DEVNET: replace the three values (DEPLOY_NETWORK=devnet, SOLANA_CLUSTER=devnet, PROJECTS_CONFIG=deploy/projects.devnet.json)
# in [env] and in both run commands. See deploy/README.md and docs/MAINNET-LAUNCH.md.
modules = ["nodejs-22"]
run = "npm install --no-audit --no-fund --include=dev && npm run build:replit && DEPLOY_NETWORK=mainnet SOLANA_CLUSTER=mainnet-beta PROJECTS_CONFIG=deploy/projects.mainnet.json npm run replit:start"

[env]
DEPLOY_NETWORK = "mainnet"
SOLANA_CLUSTER = "mainnet-beta"
PROJECTS_CONFIG = "deploy/projects.mainnet.json"
WEB_CONFIG_FILE = "deploy/wallet-test-config.json"
RPC_MONTHLY_CREDITS = "10000000"

[nix]
channel = "stable-24_05"

[deployment]
# Kept on Autoscale (no cost change by itself). The engine only indexes while an instance is awake and catches up on wake-up;
# for an engine that never sleeps, switch the deployment type to Reserved VM in the Publish panel (paid: see deploy/README.md).
deploymentTarget = "autoscale"
build = ["sh", "-c", "npm install --no-audit --no-fund --include=dev && npm run build:replit"]
run = ["sh", "-c", "DEPLOY_NETWORK=mainnet SOLANA_CLUSTER=mainnet-beta PROJECTS_CONFIG=deploy/projects.mainnet.json npm run replit:start"]

[[ports]]
localPort = 8080
externalPort = 80
