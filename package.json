{
  "name": "solana-token-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Universal, frontend-agnostic burn/progression engine for Solana SPL tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node src/db/migrate-cli.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "devnet:wallet": "node scripts/devnet/wallet.ts",
    "devnet:e2e": "node scripts/devnet/e2e.ts",
    "devnet:observe": "node scripts/devnet/observe-existing.ts",
    "devnet:simulate": "node scripts/devnet/simulate.ts",
    "devnet:probe": "node scripts/devnet/probe-confirmed.ts",
    "devnet:rpc-check": "node scripts/devnet/rpc-check.ts",
    "devnet:wallet-flow": "node scripts/devnet/wallet-flow.ts",
    "web:build": "tsc -p tsconfig.web.json",
    "web:serve": "node scripts/wallet-test/server.ts",
    "web:build:all": "tsc -p tsconfig.web.json && tsc -p tsconfig.serve.json",
    "build:replit": "npm run build && npm run web:build:all && node scripts/replit/build-info.mjs",
    "replit:start": "node web/serve-dist/scripts/replit/supervisor.js",
    "web:start": "node web/serve-dist/scripts/wallet-test/server.js",
    "web:setup": "node scripts/wallet-test/setup.ts",
    "web:browser-test": "node scripts/wallet-test/browser-test.ts",
    "mainnet:scan": "node scripts/mainnet/scan.ts",
    "mainnet:reconcile": "node scripts/mainnet/reconcile.ts",
    "mainnet:onboard": "node scripts/mainnet/onboard.ts",
    "virus:preview": "npm run web:build && tsc -p tsconfig.preview.json && node web/serve-dist/scripts/virus-preview/server.js",
    "verify:deploy": "node scripts/replit/verify-deploy.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
