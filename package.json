{
  "name": "solana-token-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Universal, frontend-agnostic burn/progression engine for Solana SPL tokens.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node src/db/migrate-cli.ts",
    "start": "node --env-file-if-exists=.env src/main.ts",
    "devnet:wallet": "node scripts/devnet/wallet.ts",
    "devnet:e2e": "node scripts/devnet/e2e.ts",
    "devnet:observe": "node scripts/devnet/observe-existing.ts",
    "devnet:simulate": "node scripts/devnet/simulate.ts",
    "devnet:probe": "node scripts/devnet/probe-confirmed.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
